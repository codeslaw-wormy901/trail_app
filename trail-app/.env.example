# Copy this file to .env and fill in your own key. .env is gitignored — never commit real keys.

# NOT CURRENTLY REQUIRED to run the app — the one region it currently
# supports (Guadalupe Mountains NP) uses a bundled offline basemap
# (src/data/guadalupe-basemap.pmtiles), not a live MapTiler fetch.
# This will matter again once live tile fetching returns for an unbundled
# region — see docs/DATA_ARCHITECTURE.md's "tile host problem" section.
# Free key from https://cloud.maptiler.com/account/keys/ (sign up, no credit card required).
EXPO_PUBLIC_MAPTILER_KEY=
